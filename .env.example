# Server Configuration
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/sendflow
REDIS_URL=redis://127.0.0.1:6379

# Email Provider Configuration
# Choose: "brevo", "smtp", or "ethereal" (default sandbox)
EMAIL_PROVIDER=ethereal

# Brevo (Sendinblue) API Key (v3)
BREVO_API_KEY=

# Custom SMTP Credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Sender Identity
FROM_EMAIL=notifications@sendflow.app
FROM_NAME=SendFlow Studio

# App & Tracking URLs
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000/api

